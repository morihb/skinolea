# Copy this file to .env and fill in real values before deploying.

# Port the API server listens on
PORT=4000

# A long, random, secret string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The public URL of your storefront (used for CORS if frontend is on a different domain/host).
# Leave as * only while testing locally.
CLIENT_ORIGIN=*

# Set to "production" when deploying for real (enables secure, httpOnly cookies over HTTPS).
NODE_ENV=development

# Optional but STRONGLY recommended for any host with a non-persistent filesystem
# (e.g. Render's free tier). Without this, your store's products/orders/settings
# are saved as local files and can be wiped on restart. With this set, everything
# is saved to MongoDB instead and survives restarts/redeploys.
# Get a free connection string from a MongoDB Atlas free (M0) cluster — see README.
# Leave blank to use local JSON files (fine for local development).
MONGODB_URI=
